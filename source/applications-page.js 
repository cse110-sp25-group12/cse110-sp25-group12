// applications-page.js
// IIFE to encapsulate the script for the applications page
(function() {
    // --- Sample Data for Applications ---
    let sampleApplicationsData = [
        { id: 1, jobTitle: "Software Engineer", companyName: "Tech Solutions Inc.", dateApplied: "2025-05-15", status: "Applied", location: "Remote", notes: "Referred by Jane Doe.", logoUrl: "https://placehold.co/64x64/D3E3FF/001C39?text=TS", applicationUrl: "#", isFavorited: false, positionType: "Full-time" },
        { id: 2, jobTitle: "Frontend Developer", companyName: "Web Wizards LLC", dateApplied: "2025-05-10", status: "Interviewing", location: "New York, NY", notes: "First interview went well.", logoUrl: "https://placehold.co/64x64/D8E3F8/111C2B?text=WW", applicationUrl: "#", isFavorited: true, positionType: "Contract" },
        { id: 3, jobTitle: "Product Manager", companyName: "Innovate Corp", dateApplied: "2025-04-28", status: "Offer", location: "San Francisco, CA", notes: "Received offer, considering.", logoUrl: "https://placehold.co/64x64/F5D9FF/261430?text=IC", applicationUrl: "#", isFavorited: false, positionType: "Full-time" },
        { id: 4, jobTitle: "UX Designer", companyName: "Creative Designs", dateApplied: "2025-05-01", status: "Rejected", location: "Austin, TX", notes: "Not a good fit for the role.", logoUrl: "https://placehold.co/64x64/FFDAD6/410002?text=CD", applicationUrl: "#", isFavorited: false, positionType: "Part-time" },
        { id: 5, jobTitle: "Backend Engineer", companyName: "Server Systems Ltd.", dateApplied: "2025-03-20", status: "Ghosted", location: "Remote", notes: "Followed up twice, no response.", logoUrl: "https://placehold.co/64x64/E7E8EE/43474E?text=SS", applicationUrl: "#", isFavorited: false, positionType: "Full-time" },
        { id: 6, jobTitle: "Data Scientist", companyName: "Alpha Analytics", dateApplied: "2025-05-18", status: "Applied", location: "Chicago, IL", notes: "Excited about this opportunity.", logoUrl: "https://placehold.co/64x64/A4C9FE/00315C?text=AA", applicationUrl: "#", isFavorited: true, positionType: "Internship" }
    ];

    // --- Application Card Rendering and Sorting ---
    function renderApplicationCards(applications) {
        const container = document.getElementById('applicationCardsContainer');
        if (!container) {
            return; 
        }
        container.innerHTML = ''; // Clear existing cards

        applications.forEach(app => {
            const cardElement = document.createElement('job-app-card'); 
            cardElement.data = app; 
            container.appendChild(cardElement);

            cardElement.addEventListener('favorite-toggled', (event) => {
                console.log('Favorite Toggled on applications page:', event.detail);
                const targetApp = sampleApplicationsData.find(a => String(a.id) === String(event.detail.id));
                if (targetApp) {
                    targetApp.isFavorited = event.detail.favorited;
                }
            });
        });
    }

    function sortApplications(criteria) {
        console.log("Sorting by criteria:", criteria); // DEBUG: Log the received criteria
        let sortedApps = [...sampleApplicationsData]; 

        switch (criteria) {
            case 'dateAppliedDesc':
                sortedApps.sort((a, b) => new Date(b.dateApplied) - new Date(a.dateApplied));
                break;
            case 'dateAppliedAsc':
                sortedApps.sort((a, b) => new Date(a.dateApplied) - new Date(b.dateApplied));
                break;
            case 'companyNameAsc':
                sortedApps.sort((a, b) => a.companyName.localeCompare(b.companyName));
                break;
            case 'companyNameDesc':
                sortedApps.sort((a, b) => b.companyName.localeCompare(a.companyName));
                break;
            case 'status':
                const statusOrder = { "Offer": 1, "Interviewing": 2, "Applied": 3, "Screening": 4, "Ghosted": 5, "Rejected": 6 };
                sortedApps.sort((a, b) => (statusOrder[a.status] || 99) - (statusOrder[b.status] || 99));
                break;
            default:
                console.warn("Unknown sorting criteria:", criteria); // DEBUG: Log if criteria is unexpected
                break;
        }
        console.log("Sorted apps:", sortedApps.map(app => app.jobTitle + ' - ' + app.companyName)); // DEBUG: Log sorted titles
        renderApplicationCards(sortedApps);
    }
    
    // --- Initialize Applications Page Specific Logic ---
    function initializeApplicationsPage() {
        const appSortingControls = document.getElementById('appSortingControls');
        const applicationCardsContainer = document.getElementById('applicationCardsContainer');

        if (applicationCardsContainer) { 
            renderApplicationCards(sampleApplicationsData); 
        }

        if (appSortingControls) {
            appSortingControls.addEventListener('sort-changed', (event) => {
                // **** CRITICAL DEBUGGING STEP ****
                console.log("Event 'sort-changed' received in applications-page.js. Detail:", event.detail); 
                if (event.detail && event.detail.value) {
                    sortApplications(event.detail.value);
                } else {
                    console.error("Sort event received without expected detail.value:", event);
                }
            });
        } else {
            // console.warn("#appSortingControls not found on this page. Sorting will not work.");
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeApplicationsPage);
    } else {
        initializeApplicationsPage();
    }

})(); // End of IIFE
